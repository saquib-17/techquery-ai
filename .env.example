# ==============================================================================
# TechQuery AI — Environment Configuration Template (.env.example)
# ==============================================================================
# This template documents all environment variables used by the platform.
# Copy this file to .env.local for local development.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE VALUES TO VERSION CONTROL.
# ==============================================================================

# Core Operational Settings
NODE_ENV=development
APP_MODE=local
PORT=4000
LOG_LEVEL=debug
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL) — Least Privilege Configuration
# Runtime connection: restricted DML only (SELECT, INSERT, UPDATE, DELETE)
DATABASE_URL=postgresql://techquery_runtime:<runtime_password>@127.0.0.1:5432/techquery_dev

# Migration connection: used exclusively by Prisma migrate CLI
MIGRATION_DATABASE_URL=postgresql://techquery_migrator:<migrator_password>@127.0.0.1:5432/techquery_dev

# Note: Redis, AI Gateway, and Authentication secrets will be introduced in subsequent milestones.
