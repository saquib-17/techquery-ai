# TechQuery AI — API Workspace Environment Configuration Template
NODE_ENV=development
APP_MODE=local
PORT=4000
LOG_LEVEL=debug
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://techquery_runtime:<runtime_password>@127.0.0.1:5432/techquery_dev
MIGRATION_DATABASE_URL=postgresql://techquery_migrator:<migrator_password>@127.0.0.1:5432/techquery_dev

# AI Gateway (Local Ollama default, Groq optional for cloud showcase, Mock for offline testing)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
AI_LOCAL_MODEL=llama3.2:3b
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_MS=15000
