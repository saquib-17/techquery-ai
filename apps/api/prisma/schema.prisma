datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CANDIDATE
  ADMIN
}

enum UserTier {
  FREE
  PRO
}

enum ActivityType {
  RESUME_UPLOADED
  JD_ANALYZED
  MATCH_EVALUATED
  QUESTIONS_GENERATED
  ANSWER_GENERATED
  COLLECTION_CREATED
  PDF_EXPORTED
  TIER_CHANGED
}

enum ProcessingStatus {
  UPLOADED
  PENDING
  PROCESSED
  FAILED
}

enum QuestionCategory {
  THEORETICAL
  CODING
  SYSTEM_DESIGN
  BEHAVIORAL
  PROJECT_DEFENSE
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ExecutionVerdict {
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  COMPILATION_ERROR
  RUNTIME_ERROR
}

enum SessionMode {
  UNTIMED
  TIMED
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum DsaSheetStatus {
  UNSOLVED
  SOLVED
  REVISION
}

enum CsTopicStatus {
  UNSTUDIED
  LEARNED
  REVISION
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String         @map("password_hash")
  name         String         @default("User")
  role         Role           @default(CANDIDATE)
  tier         UserTier       @default(FREE)
  isVerified   Boolean        @default(false) @map("is_verified")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  candidateProfile        CandidateProfile?
  onboardingState         OnboardingState?
  resumes                 Resume[]
  jobDescriptions         JobDescription[]
  jobMatches              JobMatch[]
  questionSets            QuestionSet[]
  collections             SavedCollection[]
  activities              UserActivity[]
  codingProblems          CodingProblem[]
  assessmentSessions      AssessmentSession[]
  codingSubmissions       CodingSubmission[]
  dsaSheetProgress        UserDsaSheetProgress[]
  csProgress              UserCsProgress[]
  learningRoadmaps        LearningRoadmap[]

  @@map("users")
}

model CandidateProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  fullName           String   @map("full_name")
  phoneNumber        String?  @map("phone_number")
  location           String?
  headline           String?
  summary            String?
  currentRole        String?  @map("current_role")
  yearsOfExperience  Int?     @map("years_of_experience")
  highestEducation   String?  @map("highest_education")
  university         String?
  graduationYear     Int?     @map("graduation_year")
  linkedinUrl        String?  @map("linkedin_url")
  githubUrl          String?  @map("github_url")
  portfolioUrl       String?  @map("portfolio_url")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

model OnboardingState {
  id                    String    @id @default(uuid())
  userId                String    @unique @map("user_id")
  onboardingCompleted   Boolean   @default(false) @map("onboarding_completed")
  onboardingStep        String    @default("PROFILE") @map("onboarding_step")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_states")
}

model Resume {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  originalFileName String           @map("original_file_name")
  storedFileName   String           @unique @map("stored_file_name")
  mimeType         String           @map("mime_type")
  fileExtension    String           @map("file_extension")
  fileSize         Int              @map("file_size")
  storagePath      String           @map("storage_path")
  extractedText    String?          @map("extracted_text")
  parsedData       Json?            @map("parsed_data")
  processingStatus ProcessingStatus @default(UPLOADED) @map("processing_status")
  isPrimary        Boolean          @default(false) @map("is_primary")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis ResumeAnalysis?
  matches  JobMatch[]
  questionSets QuestionSet[]

  @@index([userId])
  @@index([userId, isPrimary])
  @@map("resumes")
}

model ResumeAnalysis {
  id            String   @id @default(uuid())
  resumeId      String   @unique @map("resume_id")
  atsScore      Int      @map("ats_score")
  sectionScores Json     @map("section_scores")
  strengths     Json
  issues        Json
  improvements  Json
  providerUsed  String   @map("provider_used")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("resume_analyses")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  familyId  String   @map("family_id")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model JobDescription {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  title          String   @db.VarChar(150)
  company        String?  @db.VarChar(150)
  rawText        String   @map("raw_text") @db.Text
  structuredJson Json     @map("structured_json")
  providerUsed   String   @map("provider_used")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches JobMatch[]
  questionSets QuestionSet[]

  @@index([userId, createdAt])
  @@map("job_descriptions")
}

model JobMatch {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  resumeId       String   @map("resume_id")
  jdId           String   @map("jd_id")
  matchScore     Int      @map("match_score")
  scoreBreakdown Json     @map("score_breakdown")
  matchedSkills  Json     @map("matched_skills")
  missingSkills  Json     @map("missing_skills")
  analysisJson   Json     @map("analysis_json")
  providerUsed   String   @map("provider_used")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume         @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobDescription JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)
  questionSets   QuestionSet[]

  @@unique([resumeId, jdId])
  @@index([userId, createdAt])
  @@index([resumeId])
  @@index([jdId])
  @@map("job_matches")
}

model QuestionSet {
  id           String             @id @default(uuid())
  userId       String             @map("user_id")
  resumeId     String?            @map("resume_id")
  jdId         String?            @map("jd_id")
  matchId      String?            @map("match_id")
  title        String             @db.VarChar(200)
  topicFocus   String             @map("topic_focus") @db.VarChar(100)
  difficulty   QuestionDifficulty @default(MEDIUM)
  totalCount   Int                @default(0) @map("total_count")
  providerUsed String             @map("provider_used") @db.VarChar(50)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume?         @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  jobDescription JobDescription? @relation(fields: [jdId], references: [id], onDelete: SetNull)
  jobMatch       JobMatch?       @relation(fields: [matchId], references: [id], onDelete: SetNull)
  questions      Question[]

  @@index([userId, createdAt])
  @@index([resumeId])
  @@index([jdId])
  @@index([matchId])
  @@map("question_sets")
}

model Question {
  id                  String             @id @default(uuid())
  questionSetId       String             @map("question_set_id")
  questionText        String             @map("question_text") @db.Text
  category            QuestionCategory
  difficulty          QuestionDifficulty
  targetedSkill       String             @map("targeted_skill") @db.VarChar(100)
  interviewerIntent   String             @map("interviewer_intent") @db.Text
  keyEvaluationPoints Json               @default("[]") @map("key_evaluation_points")
  codingProblemId     String?            @map("coding_problem_id")
  createdAt           DateTime           @default(now()) @map("created_at")

  questionSet     QuestionSet      @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  codingProblem   CodingProblem?   @relation(fields: [codingProblemId], references: [id], onDelete: SetNull)
  answer          Answer?
  collectionItems CollectionItem[]

  @@index([questionSetId])
  @@index([targetedSkill])
  @@index([category])
  @@index([codingProblemId])
  @@map("questions")
}

model Answer {
  id                  String   @id @default(uuid())
  questionId          String   @unique @map("question_id")
  shortSummary        String   @map("short_summary") @db.Text
  detailedExplanation String   @map("detailed_explanation") @db.Text
  codeSnippet         String?  @map("code_snippet") @db.Text
  timeComplexity      String?  @map("time_complexity") @db.VarChar(50)
  spaceComplexity     String?  @map("space_complexity") @db.VarChar(50)
  commonMistakes      Json     @default("[]") @map("common_mistakes")
  style               String   @default("INTERVIEW") @db.VarChar(30)
  providerUsed        String   @map("provider_used") @db.VarChar(50)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answers")
}

model SavedCollection {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([userId, createdAt])
  @@map("saved_collections")
}

model CollectionItem {
  id           String   @id @default(uuid())
  collectionId String   @map("collection_id")
  questionId   String   @map("question_id")
  addedAt      DateTime @default(now()) @map("added_at")

  collection SavedCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, questionId])
  @@index([collectionId])
  @@index([questionId])
  @@map("collection_items")
}

model UserActivity {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  activityType ActivityType @map("activity_type")
  activityDate DateTime     @map("activity_date") @db.Date
  metadata     Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, activityDate(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("user_activities")
}

model CodingProblem {
  id              String            @id @default(uuid())
  userId          String?           @map("user_id")
  title           String            @db.VarChar(200)
  slug            String            @unique @db.VarChar(220)
  difficulty      ProblemDifficulty
  pattern         String            @db.VarChar(60)
  statement       String            @db.Text
  constraints     Json              @default("[]")
  examples        Json              @default("[]")
  starterCode     Json              @map("starter_code")
  driverCode      Json?             @map("driver_code")
  sampleTestCases Json              @default("[]") @map("sample_test_cases")
  hiddenTestCases Json              @default("[]") @map("hidden_test_cases")
  hints           Json              @default("[]")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user               User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  questions          Question[]
  assessmentProblems AssessmentSessionProblem[]
  submissions        CodingSubmission[]

  @@index([userId])
  @@index([difficulty, pattern])
  @@map("coding_problems")
}

model AssessmentSession {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  title            String           @db.VarChar(200)
  mode             SessionMode      @default(TIMED)
  difficultyPreset String           @default("EASY_TO_MEDIUM") @map("difficulty_preset") @db.VarChar(40)
  status           AssessmentStatus @default(IN_PROGRESS)
  durationMinutes  Int?             @map("duration_minutes")
  startedAt        DateTime         @default(now()) @map("started_at")
  expiresAt        DateTime?        @map("expires_at")
  completedAt      DateTime?        @map("completed_at")
  totalScore       Int              @default(0) @map("total_score")
  draftsJson       Json             @default("{}") @map("drafts_json")

  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  problems    AssessmentSessionProblem[]
  submissions CodingSubmission[]

  @@index([userId, status])
  @@index([userId, startedAt])
  @@map("assessment_sessions")
}

model AssessmentSessionProblem {
  id           String  @id @default(uuid())
  sessionId    String  @map("session_id")
  problemId    String  @map("problem_id")
  orderIndex   Int     @map("order_index")
  maxPoints    Int     @default(100) @map("max_points")
  earnedPoints Int     @default(0) @map("earned_points")
  solved       Boolean @default(false)

  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  problem CodingProblem     @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([sessionId, orderIndex])
  @@index([sessionId])
  @@index([problemId])
  @@map("assessment_session_problems")
}

model CodingSubmission {
  id                  String           @id @default(uuid())
  userId              String           @map("user_id")
  problemId           String           @map("problem_id")
  assessmentSessionId String?          @map("assessment_session_id")
  language            String           @db.VarChar(30)
  code                String           @db.Text
  verdict             ExecutionVerdict
  passedCount         Int              @map("passed_count")
  totalCount          Int              @map("total_count")
  runtimeMs           Int              @map("runtime_ms")
  memoryKb            Int              @map("memory_kb")
  createdAt           DateTime         @default(now()) @map("created_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem           CodingProblem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  assessmentSession AssessmentSession? @relation(fields: [assessmentSessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([problemId])
  @@index([assessmentSessionId])
  @@map("coding_submissions")
}

model UserDsaSheetProgress {
  id          String         @id @default(uuid())
  userId      String         @map("user_id")
  problemSlug String         @map("problem_slug") @db.VarChar(180)
  status      DsaSheetStatus @default(UNSOLVED)
  notes       String?        @db.Text
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemSlug])
  @@index([userId, status])
  @@map("user_dsa_sheet_progress")
}

model UserCsProgress {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  topicSlug String        @map("topic_slug") @db.VarChar(180)
  status    CsTopicStatus @default(UNSTUDIED)
  notes     String?       @db.Text
  updatedAt DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicSlug])
  @@index([userId, status])
  @@map("user_cs_progress")
}

model LearningRoadmap {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  title         String   @db.VarChar(180)
  targetRole    String   @map("target_role") @db.VarChar(120)
  durationWeeks Int      @map("duration_weeks")
  dailyHours    Float    @map("daily_hours")
  currentLevel  String   @map("current_level") @db.VarChar(20)
  phases        Json
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("learning_roadmaps")
}
